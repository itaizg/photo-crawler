# Optional overrides for docker-compose.yml. Copy to .env (git-ignored) and edit.
# Every variable has a non-secret default in docker-compose.yml, so this file is not required.

# Database user for both the `airflow` and `faces` databases.
# The local database uses no password (POSTGRES_HOST_AUTH_METHOD=trust) and listens on 127.0.0.1 only.
# Before exposing it beyond your machine, set POSTGRES_PASSWORD here and add it to the DSNs below.
POSTGRES_USER=faces

# Parallel face-detection slots (Airflow pool `face_cpu`). Each needs about 1.5 GB of RAM.
FACE_WORKERS=2

# UID the Airflow containers run as (match your host user on Linux to avoid permission issues).
AIRFLOW_UID=50000
